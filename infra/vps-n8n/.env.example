# =========================================================================
# VPS n8n — Variáveis de Ambiente
# =========================================================================

# Domínio do n8n e URL pública do Gateway de Webhooks
N8N_HOST=n8n.seudominio.com
WEBHOOK_URL=https://api.seudominio.com/

# Banco de Dados Local do n8n (PostgreSQL 16)
POSTGRES_DB=n8n_db
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=sua_senha_postgres_n8n_aqui
