# =========================================================================
# VPS Evolution API — Variáveis de Ambiente
# =========================================================================

# URL pública da Evolution API (via Nginx com HTTPS)
SERVER_URL=https://whatsweb.alvoestrategia.com.br

# Chave mestra global da Evolution API (utilizada pelo n8n para criar/gerenciar instâncias)
AUTHENTICATION_API_KEY=sua_chave_global_evolution_aqui

# Banco de Dados Local (PostgreSQL 16)
POSTGRES_DB=evolution_db
POSTGRES_USER=evolution
POSTGRES_PASSWORD=sua_senha_postgres_evolution_aqui

# Redis Local (Cache e Filas)
REDIS_PASSWORD=sua_senha_redis_evolution_aqui
