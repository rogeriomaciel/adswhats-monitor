    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const jwt = require('jsonwebtoken');\nconst triggerData = $('Initial').first().json || {};\nconst headers = triggerData.headers || {};\nconst body = triggerData.body || {};\nconst configData = $('Config').first().json || {};\n\nconst authHeader = headers.authorization || headers.Authorization || '';\nif (!authHeader || !authHeader.startsWith('Bearer ')) {\n  return { json: { action: 'ERROR', statusCode: 401, error: 'Acesso não autorizado: Token Bearer não fornecido.' } };\n}\n\nconst token = authHeader.split(' ')[1];\nconst configList = Array.isArray(configData?.itens) ? configData.itens : [];\n\nconst configsMap = {};\nconfigList.forEach(item => {\n  if (item && item.key) configsMap[item.key] = item.value;\n});\n\nconst secret = (configsMap.jwtkey || '').trim();\nif (!secret) {\n  return { json: { action: 'ERROR', statusCode: 500, error: 'Erro de configuração: chave jwtkey ausente na tabela configs.' } };\n}\n\ntry {\n  const decoded = jwt.verify(token, secret);\n  const rawAction = body.action || 'DEFAULT';\n  const normalizedAction = rawAction.toUpperCase().replace(/_/g, '-');\n  const targetWorkflowName = `ADSWHATHS-PANEL-ACTION-${normalizedAction}`;\n\n  return {\n    json: {\n      action: rawAction,\n      targetWorkflowName,\n      statusCode: 200,\n      user: decoded,\n      body: body.payload || body,\n      configs: configsMap\n    }\n  };\n} catch (err) {\n  return { json: { action: 'ERROR', statusCode: 403, error: 'Acesso negado: Token inválido ou expirado.' } };\n}"
      },
