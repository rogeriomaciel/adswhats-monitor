# URL base da API / Webhooks do n8n (sem barra no final)
# Staging: https://api-staging.rogeriomaciel.com.br/app
# Local: http://localhost:5678/webhook
VITE_API_URL=https://api-staging.rogeriomaciel.com.br/app

# Versão do aplicativo
VITE_APP_VERSION=1.0.0

# --- Credenciais da API do n8n (Deploy via scripts/deploy_workflows_via_api.js) ---
STAGING_N8N_HOST=api-staging.rogeriomaciel.com.br
STAGING_N8N_API_KEY=sua_api_key_do_n8n_aqui

PROD_N8N_HOST=api.rogeriomaciel.com.br
PROD_N8N_API_KEY=sua_api_key_prod_aqui
