# URL base da API / Webhooks do n8n (sem barra no final)
# Staging/Dev: https://api-staging.seudominio.com/app
# Produção: https://api.seudominio.com/app
# Local: http://localhost:5678/webhook
VITE_API_URL=https://api-staging.seudominio.com/app

# Versão do aplicativo
VITE_APP_VERSION=1.0.0

# --- Credenciais da API do n8n (Deploy via scripts/deploy_workflows_via_api.js) ---
STAGING_N8N_HOST=api-staging.seudominio.com
STAGING_N8N_API_KEY=sua_api_key_staging_aqui

PROD_N8N_HOST=api.seudominio.com
PROD_N8N_API_KEY=sua_api_key_prod_aqui
